# --- Negocio ---------------------------------------------------------------
APPOS_NOMBRE=APPOS
APPOS_SITIO=https://www.appos.cl
APPOS_CORREO=contacto@appos.cl
# Tu WhatsApp en formato internacional, sin + ni espacios
APPOS_WHATSAPP=569XXXXXXXX
APPOS_INSTAGRAM=apposchile
APPOS_VENDEDOR=Alejandro

# --- Shopify ---------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=www.appos.cl
# Shopify admin > Configuracion > Notificaciones > Webhooks > clave de firma
SHOPIFY_WEBHOOK_SECRET=

# --- Correo ----------------------------------------------------------------
# consola = no envia nada, solo muestra (usalo para probar)
# resend | brevo = envio real
EMAIL_PROVIDER=consola
EMAIL_API_KEY=
EMAIL_FROM=contacto@appos.cl
EMAIL_FROM_NAME=APPOS

# --- WhatsApp --------------------------------------------------------------
# links = genera enlaces wa.me para enviar desde la app WhatsApp Business (lo que usas hoy)
# cloud = envio automatico, solo si algun dia activas WhatsApp Cloud API de Meta
WHATSAPP_MODE=links
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# --- Instagram (opcional) --------------------------------------------------
# Requiere cuenta Instagram Business vinculada a una pagina de Facebook
IG_USER_ID=
IG_TOKEN=

# --- Servidor --------------------------------------------------------------
PORT=3000
# Clave para abrir el panel desde el celular. Inventa una larga.
PANEL_TOKEN=
# Hora de Chile a la que se arma la cola del dia y salen los correos
HORA_RUTINA=9
# Poner en 0 para desactivar la rutina automatica
RUTINA_AUTOMATICA=1
# Correo resumen cada manana a APPOS_CORREO. Poner en 0 para no recibirlo.
# Necesita EMAIL_PROVIDER real (no 'consola') para que llegue de verdad.
RESUMEN_DIARIO=1
# Direccion publica del panel, para que el resumen traiga el enlace directo
PANEL_URL=
